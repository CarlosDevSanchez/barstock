# Copy to .env.local and fill in. Validated by lib/env/schema.ts (next dev / next build fail if something is missing).

# Supabase (local: `bun run db:start` prints these; hosted: Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS: used exclusively to invite users. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app (base for invitation and password-reset links)
APP_URL=http://localhost:3000

# Optional. Bearer token for the daily business-day cron (GET /api/cron/tick). When unset the route answers 503.
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# Cloudflare R2 (product and receipt-logo images, lib/server/storage.ts). SERVER ONLY.
# Optional AS A GROUP: set all four or leave all four blank. With none set, `next build`/`next dev` still work,
# and the image upload endpoints answer 503 storage_not_configured (the UI hides the image picker).
# Use an R2 API token scoped to this one bucket with "Object Read & Write" permission only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# LOCAL DEV ONLY, optional: point storage.ts at an S3-compatible endpoint instead of the real R2 host, e.g. the
# MinIO container from docker-compose.r2.yml (`bun run local:up` / `local:dev` set this automatically). Leave unset
# to use real R2; never set in production.
#
# Host-based `bun run db:start` + `bun run dev` (MinIO already up from a prior local:up/dev, console :9001):
# R2_ACCOUNT_ID=barstock-local
# R2_ACCESS_KEY_ID=barstock-local
# R2_SECRET_ACCESS_KEY=barstock-local-2026
# R2_BUCKET=barstock-local
# R2_ENDPOINT_OVERRIDE=http://localhost:9000
# R2_PUBLIC_ENDPOINT_OVERRIDE is only needed when the app runs INSIDE Docker (upload host = http://r2:9000) but the
# browser is on the host (signed URLs must use http://localhost:9000). `local:up` / `local:dev` set both.

# Staff alerts (Resend email + Web Push). SERVER ONLY.
# Optional AS A GROUP: set all five or leave all five blank. With none set, `next build`/`next dev` still work;
# dispatchOutbox skips email/push when keys are missing. Generate VAPID with `npx web-push generate-vapid-keys`.
RESEND_API_KEY=
EMAIL_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
