{
  "name": "pos-inventory",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.1",
  "engines": {
    "node": ">=20.9.0",
    "bun": ">=1.4.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun run test:unit && bun run test:components && bun run test:integration",
    "test:unit": "bun test lib stores && bun test test/offline",
    "test:integration": "bun test $(find test/integration -maxdepth 1 -name '*.test.ts' ! -name 'notifications-dispatch.test.ts') && bun test test/integration/notifications-dispatch.test.ts",
    "test:e2e": "playwright test",
    "audit": "bun audit",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > types/database.ts",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build",
    "test:components": "for f in test/components/*.test.tsx; do bun test \"$f\" || exit 1; done",
    "test:coverage": "rm -rf coverage && bun test lib stores --coverage --coverage-reporter=lcov --coverage-dir=coverage/unit && bun test test/offline && bun test $(find test/integration -maxdepth 1 -name '*.test.ts' ! -name 'notifications-dispatch.test.ts') --coverage --coverage-reporter=lcov --coverage-dir=coverage/integration && bun test test/integration/notifications-dispatch.test.ts --coverage --coverage-reporter=lcov --coverage-dir=coverage/integration-dispatch && bun run scripts/coverage-check.ts",
    "local:up": "bash scripts/local-up.sh",
    "local:dev": "bash scripts/local-dev.sh",
    "local:down": "bash scripts/local-down.sh",
    "local:reset": "bash scripts/local-down.sh --reset",
    "local:seed": "eval \"$(supabase status -o env)\" && SUPABASE_URL=\"$API_URL\" SUPABASE_SERVICE_ROLE_KEY=\"$SERVICE_ROLE_KEY\" bun run scripts/seed-local.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "aws4fetch": "1.0.20",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "0.563.0",
    "next": "16.3.5",
    "next-intl": "4.14.6",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "recharts": "3.10.1",
    "resend": "6.28.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "web-push": "3.6.7",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.14.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  },
  "trustedDependencies": []
}
